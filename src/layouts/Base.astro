---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import { withBase } from '../lib/url';

interface Props {
  title?: string;
  description?: string;
}

const site = 'Carrying Capacity';
const {
  title,
  description = 'An interactive population ecology review: density and dispersion, growth models, life histories, regulation, and the human population.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />
    <title>{title ? `${title} | ${site}` : site}</title>
    <ClientRouter />
    <script is:inline>
      function applySavedSimpleEnglishPreference() {
        try {
          const simpleEnglishIsOn = JSON.parse(localStorage.getItem('carrying-capacity:simple-english')) === true;
          document.documentElement.toggleAttribute('data-simple-english', simpleEnglishIsOn);
        } catch {}
      }
      applySavedSimpleEnglishPreference();
      document.addEventListener('astro:after-swap', applySavedSimpleEnglishPreference);
    </script>
  </head>
  <body>
    <header class="site-header page">
      <a class="wordmark" href={withBase()}>{site}</a>
      <nav aria-label="Main">
        <button class="simple-english-toggle" aria-pressed="false">
          <span class="switch" aria-hidden="true"></span>
          Simple English mode
        </button>
        <a href={withBase('#units')}>Units</a>
      </nav>
    </header>
    <main class="page">
      <slot />
    </main>
    <footer class="site-footer page">
      <p>
        A population ecology review. Source on <a href="https://github.com/Earth1283/bio-review">GitHub</a>, licensed
        AGPL-3.0.
      </p>
    </footer>
  </body>
</html>

<script>
  import { saveJson } from '../lib/progress';

  const SIMPLE_ENGLISH_KEY = 'carrying-capacity:simple-english';

  function connectSimpleEnglishToggle() {
    const toggle = document.querySelector<HTMLButtonElement>('.simple-english-toggle');
    if (!toggle) return;
    const simpleEnglishIsOn = () => document.documentElement.hasAttribute('data-simple-english');
    toggle.setAttribute('aria-pressed', String(simpleEnglishIsOn()));
    toggle.addEventListener('click', () => {
      const turnOn = !simpleEnglishIsOn();
      document.documentElement.toggleAttribute('data-simple-english', turnOn);
      toggle.setAttribute('aria-pressed', String(turnOn));
      saveJson(SIMPLE_ENGLISH_KEY, turnOn);
    });
  }

  document.addEventListener('astro:page-load', connectSimpleEnglishToggle);
</script>

<style>
  .site-header {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem 1.5rem;
    align-items: baseline;
    justify-content: space-between;
    padding-block: 1.4rem;
  }

  .wordmark {
    font-style: italic;
    font-weight: 500;
    font-size: 1.15rem;
    text-decoration: none;
  }

  nav {
    display: flex;
    align-items: center;
    gap: 1.4rem;
  }

  .simple-english-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--sans);
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--ink);
    background: transparent;
    border: 1px solid var(--rule);
    border-radius: 999px;
    padding: 0.3rem 0.85rem 0.3rem 0.4rem;
    cursor: pointer;
  }

  .simple-english-toggle:hover {
    border-color: var(--ink-soft);
  }

  .switch {
    position: relative;
    width: 2rem;
    height: 1.15rem;
    border-radius: 999px;
    background: var(--rule);
    transition: background 150ms ease-out;
  }

  .switch::after {
    content: '';
    position: absolute;
    top: 0.15rem;
    left: 0.15rem;
    width: 0.85rem;
    height: 0.85rem;
    border-radius: 50%;
    background: var(--paper-raised);
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.25);
    transition: transform 150ms ease-out;
  }

  .simple-english-toggle[aria-pressed='true'] {
    border-color: var(--third);
  }

  .simple-english-toggle[aria-pressed='true'] .switch {
    background: var(--third);
  }

  .simple-english-toggle[aria-pressed='true'] .switch::after {
    transform: translateX(0.85rem);
  }

  nav a {
    font-family: var(--sans);
    font-weight: 500;
    text-decoration: none;
  }

  nav a:hover,
  .wordmark:hover {
    color: var(--prey);
  }

  .site-footer {
    margin-top: 6rem;
    padding-block: 2rem 3rem;
    border-top: 1px solid var(--rule);
    font-family: var(--sans);
    font-size: 0.95rem;
    color: var(--ink-soft);
  }
</style>
